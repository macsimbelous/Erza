<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Risa.FullScreenWindow"
        WindowState="FullScreen"
        xmlns:paz="using:Avalonia.Controls.PanAndZoom"
        Opened="OnOpened"
        Title="FullScreenWindow">
    <!-- ZoomBorder перехватывает колесико мыши для зума и клик+перетаскивание для панорамирования -->
    <paz:ZoomBorder x:Name="ZoomBorder"
                    Stretch="Uniform"
                    ZoomSpeed="1.2"
                    MinZoomX="0.5" MaxZoomX="10"
                    MinZoomY="0.5" MaxZoomY="10"
                    ClipToBounds="True"
                    Focusable="True"
                    Grid.Row="0" Grid.Column="2" Grid.RowSpan="3"
                    Background="Transparent">
        <Image x:Name="CurrentImage" />
    </paz:ZoomBorder>
</Window>
